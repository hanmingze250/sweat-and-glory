[Unit]
Description=Damei Google Play purchase verification endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=damei-verify
Group=damei-verify
WorkingDirectory=/opt/damei-verify
ExecStart=/usr/bin/node /opt/damei-verify/verify.js
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8377
Environment=SERVICE_ACCOUNT_KEY=/opt/damei-verify/service-account.json
Environment=PACKAGE_NAME=com.karlmao.healthjournal.damei
Environment=ALLOWED_PRODUCT_IDS=damei_pro
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/damei-verify
StandardOutput=journal
StandardError=journal
SyslogIdentifier=damei-verify

[Install]
WantedBy=multi-user.target
